{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run docs:build",
  "outputDirectory": ".vitepress/dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/README",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/README",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
